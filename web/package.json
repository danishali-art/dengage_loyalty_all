{
  "name": "loyalty-portal-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "prebuild": "npm run api:check",
    "preview": "vite preview",
    "type-check": "vue-tsc -b",
    "lint": "eslint .",
    "format": "prettier --write src tools openapi e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "api:spec": "tsx tools/openapi/generate-spec.ts",
    "api:types": "tsx tools/openapi/generate-types.ts",
    "api:check": "tsx tools/openapi/check-spec.ts",
    "api:check:backend": "tsx tools/openapi/check-spec.ts --backend",
    "api:sync": "tsx tools/openapi/sync-spec.ts"
  },
  "dependencies": {
    "@lucide/vue": "1.55.0",
    "@tanstack/vue-query": "5.104.1",
    "@vee-validate/zod": "4.15.1",
    "@vueuse/core": "14.4.0",
    "big.js": "7.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jwt-decode": "4.0.0",
    "openapi-fetch": "0.17.0",
    "pinia": "4.0.3",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vee-validate": "4.15.1",
    "vue": "3.5.43",
    "vue-i18n": "11.4.14",
    "vue-router": "5.4.0",
    "vue-sonner": "2.0.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/big.js": "7.0.0",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "playwright-core": "1.62.1"
  }
}
