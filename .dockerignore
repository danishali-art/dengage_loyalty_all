# Images are built with the repo root as context (Dockerfiles COPY . . so NuGet.Config is
# available). Keep everything that isn't backend or Vue portal source out of the build context.

# Local credentials and developer-only settings must never be baked into an image.
**/.env
**/*.env.local
**/appsettings.Development.json
**/Properties/launchSettings.json

# Build output and tooling state
**/bin/
**/obj/
**/.vs/
**/.vscode/
**/.idea/
.git/
.github/
.claude/

# Admin portal (web/): its source goes into the dengage.loyalty.frontend image; its local build
# and test output doesn't.
**/node_modules/
web/dist/
web/coverage/
web/test-results/
web/playwright-report/
web/**/*.tsbuildinfo

# Docs, scripts, data dumps and local infra
docs/
scripts/
*.md
docker-compose*.yml
run.ps1
