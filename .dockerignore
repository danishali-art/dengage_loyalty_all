# Images are built with the repo root as context (Dockerfiles COPY . . so NuGet.Config is
# available). Keep everything that isn't backend or Vue portal source out of the build context.

# Local credentials and developer-only settings must never be baked into an image.
**/.env
**/*.env.local
**/appsettings.Development.json
**/Properties/launchSettings.json

# Build output and tooling state
**/bin/
**/obj/
**/.vs/
**/.vscode/
**/.idea/
.git/
.github/
.claude/

# Front-ends: only the Vue portal (webVue3) is built into an image (dengage.loyalty.frontend).
# The Angular portal (web/) is never deployed.
web/
**/node_modules/
webVue3/dist/
webVue3/coverage/
webVue3/test-results/
webVue3/playwright-report/
webVue3/**/*.tsbuildinfo

# Docs, scripts, data dumps and local infra
docs/
scripts/
*.md
docker-compose*.yml
run.ps1
