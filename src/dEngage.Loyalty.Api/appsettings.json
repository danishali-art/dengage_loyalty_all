{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "loyalty-api",
    "Audience": "loyalty-dashboard",
    "ExpiryMinutes": 60
  },
  "RabbitMq": {
    "GenericEventTypes": []
  },
  "RateLimit": {
    "EventIngestionPerMinutePerTenant": 600
  }
}
