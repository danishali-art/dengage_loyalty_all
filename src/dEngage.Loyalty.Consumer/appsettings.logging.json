{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "dEngage.Loyalty": "Debug"
    }
  },
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": true,
    "extensions": [
      {
        "assembly": "NLog.Web.AspNetCore"
      },
      {
        "assembly": "NLog.Web.AspNetCore.Targets.Gelf"
      },
      {
        "assembly": "NLog.Targets.Seq"
      },
      {
        "assembly": "NLog.Extensions.Logging"
      }
    ],
    "variables": {
      "applicationName": "dEngage.Loyalty.Consumer",
      "graylogEndPoint": "udp://10.88.0.171:12201"
    },
    "targets": {
      "console": {
        "type": "ColoredConsole",
        "layout": "${longdate} ${level:uppercase=true} ${logger}: ${message}${onexception:${newline}${exception:format=ToString}}"
      },
      "graylog": {
        "type": "Gelf",
        "endpoint": "${graylogEndPoint}",
        "facility": "${applicationName}",
        "SendLastFormatParameter": true
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Debug",
        "writeTo": "console"
      },
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "graylog"
      }
    ]
  }
}
