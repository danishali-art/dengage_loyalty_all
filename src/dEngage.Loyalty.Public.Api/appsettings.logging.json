{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": true,
    "extensions": [
      { "assembly": "NLog.Web.AspNetCore" },
      { "assembly": "NLog.Web.AspNetCore.Targets.Gelf" },
      { "assembly": "NLog.Targets.Seq" },
      { "assembly": "NLog.Extensions.Logging" }
    ],
    "variables": {
      "applicationName": "dEngage.Loyalty.Public.Api"
    },
    "targets": {
      "console": {
        "type": "ColoredConsole",
        "layout": "${longdate} ${level:uppercase=true} ${logger}: ${message}${onexception:${newline}${exception:format=ToString}}"
      }
    },
    "rules": [
      { "logger": "*", "minLevel": "Info", "writeTo": "console" }
    ]
  }
}
