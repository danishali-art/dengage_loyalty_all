<Project Sdk="Microsoft.NET.Sdk">

  <!-- Typed HTTP client for dEngage.Loyalty.Public.Api (platform alignment D9), published as a
       NuGet package through build.json, like the platform's other *.Api.Client packages: for the
       dEngage connector and any service that sends loyalty events. netstandard2.0 like the Contract
       package. Deliberately no dEngage.Common.* dependency (it would pull the platform's SecMan
       into every consumer): only the Contract package and Microsoft.Extensions.Http. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <Authors>dEngage</Authors>
    <Description>Typed HTTP client for the dEngage Loyalty Public API: event ingestion and event status, authenticated by per-tenant API key.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\dEngage.Loyalty.Contract\dEngage.Loyalty.Contract.csproj" />
  </ItemGroup>

</Project>
