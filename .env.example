ANTHROPIC_API_KEY=

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=loyalty
CONNECTION_STRING=Host=localhost;Port=5432;Database=loyalty;Username=postgres;Password=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASS=

# Platform hosting (deployed environments; leave unset locally)
# CONFIG_PATH: folder holding the mounted appsettings*.json files
# NLOG_CONFIG_PATH: optional folder for appsettings.logging.json if it lives elsewhere
CONFIG_PATH=
NLOG_CONFIG_PATH=

# Key for ENC(...) config values. Deployed: path to a mounted secret file. Local: the key itself.
LOYALTY_MASTER_KEY_FILE=
LOYALTY_MASTER_KEY=
